VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Из Supabase → Connect (новое имя). Старое имя VITE_SUPABASE_ANON_KEY тоже работает.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Секретный код для регистрации администраторов.
# Открой ссылку вида /admin-invite/<этот-код> чтобы создать админа.
# Подставь длинную случайную строку (например, любой UUID без дефисов).
VITE_ADMIN_INVITE_CODE=replace-me-with-long-random-string
